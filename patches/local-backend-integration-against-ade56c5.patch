diff --git a/Sw/Tpu.h b/Sw/Tpu.h
index 8274c73..934afeb 100644
--- a/Sw/Tpu.h
+++ b/Sw/Tpu.h
@@ -31,6 +31,16 @@ static inline uint32_t TpuStore(uint32_t Address, uint32_t Spec, uint32_t Slot)
     return Result;
 }
 
+// Standalone FF1: one 64->256 row, using compact slots 0/6/1.
+// Row is deliberately not masked: invalid upper bits must reach RTL checks.
+static inline uint32_t TpuExecFf1Row(uint32_t Row, uint32_t Fraction) {
+    uint32_t Result;
+    uint32_t Meta = 10 | (6 << 7) | (1 << 13) | (1 << 16) | (Fraction << 17);
+    __asm__ volatile (".insn r 0x7b, 7, 1, %0, %1, %2"
+        : "=r"(Result) : "r"(Meta), "r"(Row) : "memory");
+    return Result;
+}
+
 // Bits 0..5: compute busy, DMA busy, compute done, DMA done, command error, DMA error.
 // Bits 2..5 in ClearMask are write-one-to-clear; return value is before clear.
 static inline uint32_t TpuStatus(uint32_t ClearMask) {
