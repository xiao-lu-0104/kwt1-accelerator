diff --git a/Sw/Encoder.c b/Sw/Encoder.c
index f6a7b34..2d92793 100644
--- a/Sw/Encoder.c
+++ b/Sw/Encoder.c
@@ -57,3 +57,24 @@ int TpuRunLayer(const TpuLayerParams *Params) {
     if (Execute(9, 0, 6, 7, 1, 1, Fraction(Params, 5), Fraction(Params, 6))) return -1;
     return Norm(Params->Norm2, Fraction(Params, 7));
 }
+
+// The 99x256 output never needs to reside in private SRAM simultaneously.
+// Wait for every row's final bus write response before reusing output slot 1.
+int TpuRunFf1(uint32_t InputAddress, uint32_t ParameterAddress,
+              uint32_t OutputAddress, uint32_t ParameterFraction) {
+    if (((InputAddress | ParameterAddress | OutputAddress) & 15)
+        || ParameterFraction == 0 || ParameterFraction > 15
+        || OutputAddress > UINT32_MAX - 50687 || (TpuStatus(0) & 3)) return -1;
+    TpuStatus(0x3c);
+    TpuLoad(InputAddress, 0, 0);
+    if (TpuWait(2)) return -1;
+    TpuLoad(ParameterAddress, 3, 6);
+    if (TpuWait(2)) return -1;
+    for (uint32_t Row = 0; Row < 99; ++Row) {
+        TpuExecFf1Row(Row, ParameterFraction);
+        if (TpuWait(1)) return -1;
+        TpuStore(OutputAddress + Row * 512, 9, 1);
+        if (TpuWait(2)) return -1;
+    }
+    return 0;
+}
